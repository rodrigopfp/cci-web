{
	# Sin panel de administración: no se necesita y es una puerta menos.
	admin off
	# Railway termina el TLS en su borde, así que Caddy no gestiona certificados.
	auto_https off
	# No revelar el servidor usado.
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# ---- Cabeceras de seguridad (equivalentes a las de netlify.toml) ----
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com https://cdn.sanity.io; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# Ocultar la cabecera que identifica al servidor.
		-Server
	}

	# ---- Redirecciones permanentes (revisión 22/08) ----
	# Rutas renombradas: el Radar pasó a llamarse CCI Data (/data) y la sección
	# Ecosistema se unificó en la Vitrina (/vitrina). 301 para conservar el SEO.
	redir /radar /data/ 301
	redir /radar/ /data/ 301
	redir /ecosistema /vitrina/ 301
	redir /ecosistema/ /vitrina/ 301
	# La Evidencia se fusionó en CCI Data, capítulo 4 (revisión 22/08, prompt 2).
	redir /evidencia /data/#cap4 301
	redir /evidencia/ /data/#cap4 301
	# Los Recursos se fusionaron en la Biblioteca (/conocimiento) (paso 4).
	redir /recursos /conocimiento/ 301
	redir /recursos/ /conocimiento/ 301

	# Los archivos versionados de Next nunca cambian de contenido: caché larga.
	@nextStatic path /_next/static/*
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"

	# El HTML se revalida siempre, para que una publicación se vea de inmediato.
	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# Resolución de rutas: /radar/ -> /srv/radar/index.html
	try_files {path} {path}/index.html {path}.html /404.html
	file_server
}
